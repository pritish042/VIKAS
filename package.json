{
  "name": "vikas-student-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:indexes": "node --env-file=.env.local scripts/create-indexes.mjs",
    "youtube:refresh": "node --env-file=.env.local --import tsx scripts/refresh-youtube.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "aprajita:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-aprajita-runner.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.7.6",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "next": "16.3.7",
    "nodemailer": "10.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
