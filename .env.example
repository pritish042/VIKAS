MONGODB_URI=
MONGODB_DB=vikas
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Server-side only. Never prefix with NEXT_PUBLIC_.
YOUTUBE_API_KEY=

# Optional provider settings
GEMINI_API_KEY=
GEMINI_MODEL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTENT_EDITOR_EMAILS=

# Optional APRAJITA isolated Judge0-compatible runner (server-only).
# HTTPS base URL; submission polling and X-Auth-Token authentication required.
APRAJITA_EXECUTION_URL=
APRAJITA_EXECUTION_TOKEN=

# External execution is opt-in: none (default), jdoodle, or judge0.
# Python still defaults to free browser Pyodide; no paid plans are activated.
APRAJITA_EXECUTION_PROVIDER=none
# JDoodle Compiler API credentials are server-only, sent in the official API body.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=
# Free API account allowance shared across all app users; only 1..20 is allowed.
JDOODLE_DAILY_LIMIT=20
